{
  "name": "dsh-media-image",
  "version": "0.8.1",
  "private": true,
  "description": "DSH 图片编辑器插件：人和 Agent 共用一份 miniPaint 工程，通过受控命令协作编辑；0.2.0 起右侧为原生对话面板（四态工具卡片、只读审批、撤销只填输入框）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "public/",
    "scripts/",
    "skills/",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync-version": "node scripts/gen-version.mjs",
    "pack:image": "node scripts/pack-image.mjs"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
